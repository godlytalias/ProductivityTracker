<Window
    x:Class="ProductivityTracker.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ProductivityTracker"
    Title="Productivity Tracker">
    <Grid x:Name="RootGrid" x:Uid="Root" Padding="16" RowSpacing="16"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="ActivePlotBrush" Color="{ThemeResource SystemAccentColorDark1}" />
                        <SolidColorBrush x:Key="InactivePlotBrush" Color="{ThemeResource TextFillColorSecondary}" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Dark">
                        <SolidColorBrush x:Key="ActivePlotBrush" Color="{ThemeResource SystemAccentColorLight2}" />
                        <SolidColorBrush x:Key="InactivePlotBrush" Color="{ThemeResource TextFillColorSecondary}" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="HighContrast">
                        <SolidColorBrush x:Key="ActivePlotBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                        <SolidColorBrush x:Key="InactivePlotBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
                <Style x:Key="DashboardSurface" TargetType="Border">
                    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="8" />
                    <Setter Property="Padding" Value="12" />
                </Style>
                <DataTemplate x:Key="InsightCardTemplate" x:DataType="local:DashboardCard">
                    <local:InsightCard IsTabStop="False" HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    AutomationProperties.Name="{Binding AutomationSummary}">
                        <Border Style="{StaticResource DashboardSurface}">
                            <Grid RowSpacing="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding Title}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           AutomationProperties.HeadingLevel="Level3" />
                                <TextBlock Grid.Row="1" Text="{Binding Value}" FontSize="{Binding ValueFontSize}"
                                           FlowDirection="{Binding ValueFlowDirection}" TextAlignment="{Binding ValueTextAlignment}"
                                           FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="2" Text="{Binding Context}" FontSize="12" TextWrapping="Wrap"
                                           FlowDirection="{Binding ContextFlowDirection}" TextAlignment="{Binding ContextTextAlignment}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="3" Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap"
                                           VerticalAlignment="Bottom"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Border>
                    </local:InsightCard>
                </DataTemplate>
                <DataTemplate x:Key="TimelineRowTemplate" x:DataType="local:ActivityRow">
                    <Grid ColumnSpacing="12" Padding="8,10" MinWidth="590">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="100" />
                            <ColumnDefinition Width="*" MinWidth="100" />
                            <ColumnDefinition Width="2*" MinWidth="140" />
                            <ColumnDefinition Width="*" MinWidth="76" />
                            <ColumnDefinition Width="*" MinWidth="90" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding StartTime}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding EndTime}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Application}" TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{Binding Application}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{Binding Duration}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="{Binding State}" TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{Binding State}" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
                <DataTemplate x:Key="TimelineEmptyTemplate">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                MaxWidth="300" Margin="12" Spacing="6">
                        <TextBlock x:Uid="TimelineEmptyTitle"
                                   FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" />
                        <TextBlock x:Uid="TimelineEmptyExplanation" FontSize="12"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </DataTemplate>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource DashboardSurface}">
            <Grid x:Name="HeaderGrid" ColumnSpacing="16" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid x:Name="IdentityPanel" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Source="ms-appx:///Assets/ProductivityTracker-64.png" Width="32" Height="32"
                           VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Uid="BrandTitle" FontSize="20" FontWeight="SemiBold"
                                   TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1" />
                        <TextBlock x:Name="StatusText" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
                <StackPanel x:Name="DateNav" Grid.Column="1" Orientation="Horizontal" Spacing="4"
                            VerticalAlignment="Center">
                    <Button x:Name="PreviousDayButton" x:Uid="PreviousDay" Click="PreviousDayButton_Click" Padding="8">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Menu" Key="Left" />
                        </Button.KeyboardAccelerators>
                        <FontIcon Glyph="&#xE76B;" FontSize="14" MirroredWhenRightToLeft="True" />
                    </Button>
                    <CalendarDatePicker x:Name="UsageDatePicker" x:Uid="UsageDatePicker" MinWidth="180" MaxWidth="260"
                                        DateFormat="dayofweek.abbreviated day month.abbreviated year"
                                        IsTodayHighlighted="True"
                                        DateChanged="UsageDatePicker_DateChanged" />
                    <Button x:Name="NextDayButton" x:Uid="NextDay" Click="NextDayButton_Click" Padding="8">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Menu" Key="Right" />
                        </Button.KeyboardAccelerators>
                        <FontIcon Glyph="&#xE76C;" FontSize="14" MirroredWhenRightToLeft="True" />
                    </Button>
                    <Button x:Name="TodayButton" x:Uid="Today" Click="TodayButton_Click" />
                </StackPanel>
                <StackPanel x:Name="HeaderActions" Grid.Column="2" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <Button x:Name="TrackingButton" Click="TrackingButton_Click" />
                    <Button x:Uid="Refresh" Click="RefreshButton_Click" Padding="8">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F5" />
                        </Button.KeyboardAccelerators>
                        <FontIcon Glyph="&#xE72C;" FontSize="16" />
                    </Button>
                    <Button x:Uid="Settings" Padding="8">
                        <FontIcon Glyph="&#xE713;" FontSize="16" />
                        <Button.Flyout>
                            <Flyout x:Name="SettingsFlyout" Opened="SettingsFlyout_Opened">
                                <StackPanel Spacing="12" MaxWidth="300">
                                    <TextBlock x:Uid="SettingsHeading" FontWeight="SemiBold" FontSize="18"
                                               AutomationProperties.HeadingLevel="Level2" />
                                    <NumberBox x:Name="IdleThresholdNumberBox" x:Uid="IdleThreshold"
                                               Minimum="5" Maximum="3600" SmallChange="5" LargeChange="60"
                                               SpinButtonPlacementMode="Inline"
                                               ValueChanged="IdleThresholdNumberBox_ValueChanged" />
                                    <ToggleSwitch x:Name="RunAtSignInToggle" x:Uid="RunAtSignIn"
                                                  IsEnabled="False"
                                                  Toggled="RunAtSignInToggle_Toggled" />
                                    <TextBlock x:Uid="StartupExplanation"
                                               FontSize="12" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <HyperlinkButton x:Uid="OpenDataFolder" Padding="0"
                                                     Click="OpenDataFolder_Click" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button x:Uid="About" Padding="8">
                        <FontIcon Glyph="&#xE946;" FontSize="16" />
                        <Button.Flyout>
                            <Flyout>
                                <StackPanel Spacing="8" MaxWidth="360">
                                    <TextBlock x:Uid="AboutHeading" FontSize="18" FontWeight="SemiBold"
                                               AutomationProperties.HeadingLevel="Level2" />
                                    <TextBlock x:Uid="AboutActive"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Uid="AboutMissing"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Uid="AboutPeriods"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Uid="AboutTime"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Uid="AboutPrivacy"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Uid="AboutSystemTime" TextWrapping="Wrap" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer x:Name="PageScroller" x:Uid="Dashboard" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled"
                      SizeChanged="Layout_SizeChanged">
            <StackPanel x:Name="DashboardWorkspace" MaxWidth="1800" HorizontalAlignment="Stretch" Spacing="16">
                <Grid x:Name="InsightsBand" ColumnSpacing="20" RowSpacing="16" SizeChanged="Layout_SizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="DayGroup" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock x:Uid="SelectedDayHeading" FontSize="16" FontWeight="SemiBold"
                                       AutomationProperties.HeadingLevel="Level2" />
                            <TextBlock x:Name="SelectedDateText" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="InactiveBreakdownText" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Grid x:Name="DayCardsGrid" Grid.Row="1" ColumnSpacing="12" RowSpacing="12" />
                    </Grid>
                    <Grid x:Name="WeekdayGroup" Grid.Column="1" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock x:Uid="PatternsHeading" FontSize="16" FontWeight="SemiBold"
                                       AutomationProperties.HeadingLevel="Level2" />
                            <TextBlock x:Name="InsightPeriodText" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Uid="PatternsDisclaimer" FontSize="12"
                                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Grid x:Name="WeekdayCardsGrid" Grid.Row="1" ColumnSpacing="12" RowSpacing="12" />
                    </Grid>
                </Grid>

                <Grid x:Name="AnalysisGrid" ColumnSpacing="16" RowSpacing="16" Height="320">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1.1*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border x:Name="ChartCard" Style="{StaticResource DashboardSurface}">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock x:Uid="ActivityHeading" FontSize="16" FontWeight="SemiBold"
                                               AutomationProperties.HeadingLevel="Level2" />
                                    <TextBlock x:Name="ChartPeriodText" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <SelectorBar x:Name="ChartModeBar" x:Uid="ChartRange" Grid.Column="1" VerticalAlignment="Center"
                                             SelectionChanged="ChartModeBar_SelectionChanged">
                                    <SelectorBarItem x:Name="WeekModeItem" x:Uid="WeekMode" IsSelected="True" />
                                    <SelectorBarItem x:Name="HourlyModeItem" x:Uid="HourlyMode" />
                                </SelectorBar>
                            </Grid>
                            <Grid Grid.Row="1">
                                <Grid x:Name="ActivityPlotHost" />
                                <StackPanel x:Name="ChartEmptyState" Visibility="Collapsed" Spacing="8"
                                            MaxWidth="320" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="ChartEmptyText"
                                               FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" />
                                    <TextBlock x:Uid="ChartEmptyExplanation"
                                               FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Button x:Name="ShowWeekButton" x:Uid="ShowWeek"
                                            HorizontalAlignment="Center" Click="ShowWeekButton_Click" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="ChartFootnote" Grid.Row="2" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </Border>
                    <Border x:Name="TimelineCard" Grid.Column="1" Style="{StaticResource DashboardSurface}">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="TimelineHeading" FontSize="16" FontWeight="SemiBold"
                                           AutomationProperties.HeadingLevel="Level2" />
                                <TextBlock x:Name="SessionCountText" Grid.Column="1" VerticalAlignment="Center"
                                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <Grid x:Name="ActivityTimelineHost" Grid.Row="1" />
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
