  </data>
  <data name="AboutHeading.Text" xml:space="preserve">
    <value>अपनी सक्रियता को समझें</value>
  </data>
  <data name="AboutActive.Text" xml:space="preserve">
    <value>सक्रिय का अर्थ है ट्रैकिंग के दौरान हाल में इनपुट मिलना। यह सहभागिता के समय का संकेत है, किए गए काम की मात्रा का माप नहीं।</value>
  </data>
  <data name="AboutMissing.Text" xml:space="preserve">
    <value>जिन अंतरालों का कारण ज्ञात नहीं है वे रिकॉर्ड नहीं माने जाते, निष्क्रिय नहीं। रैंकिंग रिकॉर्ड किए गए जागृत समय में सक्रिय प्रतिशत की तुलना करती है। कार्ड पर आधारभूत डेटा दिखता है।</value>
  </data>
  <data name="AboutPeriods.Text" xml:space="preserve">
    <value>घंटे और लगातार समय वाले कार्ड चुने गए दिन के हैं। सप्ताह के दिनों के रुझान उस तारीख तक के 28 दिनों पर आधारित हैं। अधूरे रिकॉर्ड तुलना को प्रभावित कर सकते हैं।</value>
  </data>
  <data name="AboutTime.Text" xml:space="preserve">
    <value>समय स्थानीय समय में दिखता है और UTC में सहेजा जाता है। ऐप बदलना और 3 सेकंड तक का सैंपलिंग अंतराल एक ही सक्रिय अवधि में आ सकता है, लेकिन देखी गई निष्क्रियता उसे समाप्त कर देती है।</value>
  </data>
  <data name="AboutPrivacy.Text" xml:space="preserve">
    <value>डेटा इसी PC पर रहता है। विंडो के शीर्षक, URL, दबाई गई कुंजियाँ, स्क्रीनशॉट या क्लिपबोर्ड की सामग्री रिकॉर्ड नहीं की जाती।</value>
  </data>
  <data name="AboutSystemTime.Text" xml:space="preserve">
    <value>लॉक, स्लीप और पुष्ट बंद अवधि कुल समय और चार्ट में निष्क्रिय मानी जाती हैं। स्लीप और बंद समय सक्रिय प्रतिशत तथा घंटे/सप्ताह के दिन की रैंकिंग से बाहर हैं। पावर इतिहास Windows इवेंट पर आधारित है; अनुपलब्ध या अस्पष्ट इवेंट अज्ञात रहते हैं।</value>
  </data>
